<UserControl
    x:Class="EpicenterApp.Controls.LedMeterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource StudioRackCardStyle}" Padding="14,10,14,12">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Row: Label & Readout -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Text="LEVELS"
                           Style="{StaticResource StudioTechnicalHeaderStyle}"
                           VerticalAlignment="Center" />

                <!-- Digital Peak Readout -->
                <TextBlock x:Name="ReadoutTextBlock"
                           Grid.Column="1"
                           Text="N/A"
                           FontFamily="Cascadia Mono, Consolas, Segoe UI Mono"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <!-- Clip Warning Badge -->
                <Border x:Name="ClipBadge"
                        Grid.Column="2"
                        Width="36" Height="16"
                        Background="#2B1515"
                        BorderBrush="#4D1C1C"
                        BorderThickness="1"
                        CornerRadius="3"
                        PointerPressed="OnClipBadgePointerPressed"
                        ToolTipService.ToolTip="Digital Peak Clipping Indicator: Latches on signals exceeding -0.1 dBFS. Auto-resets after 2s or click to reset.">
                    <TextBlock x:Name="ClipTextBlock"
                               Text="CLIP"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#803333"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Aggregate sample peak, not a fabricated left-channel measurement. -->
            <Grid Grid.Row="1" Height="12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PEAK" Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8"
                           VerticalAlignment="Center" />
                <Grid x:Name="PeakRail" Grid.Column="1" Height="10">
                <!-- Background Rail -->
                <Border Background="#111111" BorderBrush="{StaticResource StudioBorderSubtle}" BorderThickness="1" CornerRadius="2" />

                <!-- Current peak fill -->
                <Border x:Name="PeakBar"
                        HorizontalAlignment="Left"
                        Width="0"
                        CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#696969" Offset="0.0" />
                            <GradientStop Color="#A5A5A5" Offset="0.75" />
                            <GradientStop Color="#FF0026" Offset="0.95" />
                            <GradientStop Color="#EF4444" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Peak Hold Indicator -->
                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border x:Name="PeakNeedle"
                            Width="2" Height="10"
                            Background="#F8FAFC"
                            Canvas.Left="0" />
                </Canvas>
                </Grid>
            </Grid>

            <!-- Aggregate RMS is a separate metric, not a duplicate right channel. -->
            <Grid Grid.Row="2" Height="12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RMS" Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8"
                           VerticalAlignment="Center" />
                <Grid x:Name="RmsRail" Grid.Column="1" Height="10">
                <!-- Background Rail -->
                <Border Background="#111111" BorderBrush="{StaticResource StudioBorderSubtle}" BorderThickness="1" CornerRadius="2" />

                <!-- Active RMS Fill -->
                <Border x:Name="RmsBar"
                        HorizontalAlignment="Left"
                        Width="0"
                        CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#696969" Offset="0.0" />
                            <GradientStop Color="#A5A5A5" Offset="0.75" />
                            <GradientStop Color="#FF0026" Offset="0.95" />
                            <GradientStop Color="#EF4444" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                </Grid>
            </Grid>

            <!-- Decibel Scale Ruler -->
            <Grid Grid.Row="3" Margin="40,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="-48" Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="-36" Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="-24" Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="-12" Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="-6"  Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="0 dB" Style="{StaticResource StudioMonospaceValueStyle}" FontSize="8" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
