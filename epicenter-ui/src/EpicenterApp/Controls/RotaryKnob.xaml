<UserControl
    x:Class="EpicenterApp.Controls.RotaryKnob"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    ManipulationMode="None"
    AutomationProperties.Name="Intensidad de Epicenter"
    AutomationProperties.HelpText="Arrastra hacia arriba o abajo, usa la rueda o las flechas. Shift permite ajuste fino. Inicio aplica bypass; Fin aplica 100 por ciento."
    ToolTipService.ToolTip="Arrastra arriba/abajo · rueda · flechas · Shift: ajuste fino · doble clic: 75%">

    <Grid Width="200" Height="224" Background="Transparent">
        <!-- Decoration ignores input: the same control receives and captures pointers. -->
        <Grid x:Name="DialSurface" Width="200" Height="200"
              VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse Width="164" Height="164" Fill="#070708" Stroke="#212124" StrokeThickness="1" />
            <Canvas x:Name="TickCanvas" Width="200" Height="200" />
            <!-- Fixed full-size viewports keep both arc origins identical at every value. -->
            <Path x:Name="TrackPath" Width="200" Height="200" Stretch="None"
                  Stroke="#333336" StrokeThickness="5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="ActiveArcPath" Width="200" Height="200" Stretch="None"
                  Stroke="#FF0026" StrokeThickness="5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse x:Name="InnerDialEllipse" Width="142" Height="142"
                     Stroke="#4B4B4F" StrokeThickness="1">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                        <GradientStop Color="#37373B" Offset="0" />
                        <GradientStop Color="#202023" Offset="0.32" />
                        <GradientStop Color="#101012" Offset="0.78" />
                        <GradientStop Color="#080809" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="130" Height="130" Stroke="#18181B" StrokeThickness="1" />
            <Canvas Width="200" Height="200">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="IndicatorRotation" CenterX="100" CenterY="100" Angle="67.5" />
                </Canvas.RenderTransform>
                <Rectangle x:Name="PositionIndicator" Canvas.Left="97.5" Canvas.Top="35"
                           Width="5" Height="13" RadiusX="2.5" RadiusY="2.5" Fill="#FF0026" />
            </Canvas>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                <TextBlock x:Name="ValueTextBlock" Text="75"
                           Width="112" TextAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas, Segoe UI"
                           FontSize="36" FontWeight="SemiBold" Foreground="#F4F4F5"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="PercentLabel" Text="%" FontSize="12" FontWeight="SemiBold"
                           Foreground="#FF0026" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <TextBlock Text="INTENSIDAD" FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="10" FontWeight="SemiBold" CharacterSpacing="180" Foreground="#9D9DA3"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
