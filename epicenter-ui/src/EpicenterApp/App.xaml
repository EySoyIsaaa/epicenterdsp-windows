<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EpicenterApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Original EpicenterDSP identity: black, speaker gray and signal red. -->
            <Color x:Key="StudioBackgroundDarkColor">#090909</Color>
            <Color x:Key="StudioSurfaceCardColor">#151515</Color>
            <Color x:Key="StudioSurfaceCardHoverColor">#202020</Color>
            <Color x:Key="StudioBorderSubtleColor">#2E2E2E</Color>

            <!-- Preserve existing resource names for controls; use the supplied logo's red. -->
            <Color x:Key="EpicenterAmberGoldColor">#FF0026</Color>
            <Color x:Key="AmberGlowSoftColor">#45131B</Color>
            <Color x:Key="AmberInactiveColor">#281016</Color>
            <Color x:Key="SystemAccentColor">#FF0026</Color>

            <!-- Measurements use neutral silver so only the primary action carries red. -->
            <Color x:Key="StudioCyanMetricColor">#B8B8B8</Color>

            <!-- Text Hierarchies -->
            <Color x:Key="TextPrimaryHighColor">#F7F7F7</Color>
            <Color x:Key="TextSecondaryMutedColor">#A8A8A8</Color>
            <Color x:Key="TextDimColor">#777777</Color>

            <!-- Status Alerts -->
            <Color x:Key="StatusGreenOkColor">#10B981</Color>
            <Color x:Key="StatusRedClipColor">#EF4444</Color>
            <Color x:Key="StatusOrangeWarnColor">#F97316</Color>

            <!-- SolidColorBrushes -->
            <SolidColorBrush x:Key="StudioBackgroundDark" Color="{StaticResource StudioBackgroundDarkColor}" />
            <SolidColorBrush x:Key="StudioSurfaceCard" Color="{StaticResource StudioSurfaceCardColor}" />
            <SolidColorBrush x:Key="StudioSurfaceCardHover" Color="{StaticResource StudioSurfaceCardHoverColor}" />
            <SolidColorBrush x:Key="StudioBorderSubtle" Color="{StaticResource StudioBorderSubtleColor}" />

            <SolidColorBrush x:Key="EpicenterAmberGold" Color="{StaticResource EpicenterAmberGoldColor}" />
            <SolidColorBrush x:Key="AmberGlowSoft" Color="{StaticResource AmberGlowSoftColor}" />
            <SolidColorBrush x:Key="AmberInactive" Color="{StaticResource AmberInactiveColor}" />

            <SolidColorBrush x:Key="StudioCyanMetric" Color="{StaticResource StudioCyanMetricColor}" />

            <SolidColorBrush x:Key="TextPrimaryHigh" Color="{StaticResource TextPrimaryHighColor}" />
            <SolidColorBrush x:Key="TextSecondaryMuted" Color="{StaticResource TextSecondaryMutedColor}" />
            <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />

            <SolidColorBrush x:Key="StatusGreenOk" Color="{StaticResource StatusGreenOkColor}" />
            <SolidColorBrush x:Key="StatusRedClip" Color="{StaticResource StatusRedClipColor}" />
            <SolidColorBrush x:Key="StatusOrangeWarn" Color="{StaticResource StatusOrangeWarnColor}" />

            <!-- Studio Rack Card Style -->
            <Style x:Key="StudioRackCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioSurfaceCard}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderSubtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Studio Technical Label Style -->
            <Style x:Key="StudioTechnicalHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryMuted}" />
            </Style>

            <!-- Monospace Telemetry Value Style -->
            <Style x:Key="StudioMonospaceValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI Mono" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryMuted}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
