# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.xaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
CMakeLists.txt text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.ico binary
*.dll binary
*.exe binary
